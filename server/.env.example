# Environment Variables for AI Audit System Backend
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000

# MongoDB Atlas Connection String
# Get this from MongoDB Atlas dashboard > Connect > Connect your application
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/database?retryWrites=true&w=majority

# AI Service Configuration (Optional)
# Set to 'true' to enable AI summaries, provide API key
AI_ENABLED=true
AI_API_KEY=your_gemini_api_key_here

# Frontend URL for CORS (Production)
# This is used as one of the allowed origins in CORS config
# Replace with your actual Vercel app URL
FRONTEND_URL=https://your-app-name.vercel.app

# Email Service (for lead confirmations)
# Configure in emailService.js
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password